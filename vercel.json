{
	"$schema": "https://openapi.vercel.sh/vercel.json",
	"functions": {
		"api/cron/*.ts": { "maxDuration": 300 }
	},
	"rewrites": [{ "source": "/data/:file", "destination": "/api/data/:file" }],
	"schedules": {
		"fr": {
			"schedule": "17 4 * * *",
			"timezone": "Europe/Rome",
			"path": "/api/cron/fr",
			"requestMethod": "GET"
		},
		"osm-fr": {
			"schedule": "*/20 3-4 * * 2,4",
			"timezone": "Europe/Rome",
			"path": "/api/cron/osm-fr",
			"requestMethod": "GET"
		}
	}
}
